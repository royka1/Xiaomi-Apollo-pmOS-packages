#!/bin/sh
# Route call audio to the earpiece for as long as a call is up.
#
# Nothing in userspace can do this on its own. Call audio is mixed inside the
# ADSP and never passes through PipeWire, so there is no stream to move, and
# callaudiod's fallback -- switching the sink's output port -- has nothing to
# switch either: every UCM device lands in a profile of its own with a single
# port, so the earpiece port is never on the sink that is currently open.
#
# What does track a call exactly is q6voiced, which holds the CS-VOICE front
# end open for the call's duration. Both directions are watched: it opens the
# playback and the capture side, and either one being up means a call.
#
# The mute is re-asserted for as long as the call lasts, not just on the
# transition: any system sound played mid-call (a notification, a UI click)
# makes PipeWire re-run the Speaker device's UCM enable sequence, which turns
# the switch back on and would leak the call out of the loudspeaker.
# Speakerphone mode is deliberately not offered while echo cancellation does
# not work.

CARD=X10T
CTL="Speaker Playback Switch"
P=/proc/asound/card0/pcm3p/sub0/status
C=/proc/asound/card0/pcm3c/sub0/status

speaker_is_on() {
	amixer -c "$CARD" cget name="$CTL" 2>/dev/null | grep -q ": values=on"
}

prev=
while :; do
	sp=$(cat "$P" 2>/dev/null)
	sc=$(cat "$C" 2>/dev/null)

	if [ "$sp" = "closed" ] && [ "$sc" = "closed" ]; then
		now=idle
	else
		now=call
	fi

	if [ "$now" != "$prev" ]; then
		echo "call-route: ${prev:-start} -> $now"
		prev=$now
		case $now in
		call)	amixer -q -c "$CARD" cset name="$CTL" 0 ;;
		idle)	amixer -q -c "$CARD" cset name="$CTL" 1 ;;
		esac
	elif [ "$now" = call ] && speaker_is_on; then
		# PipeWire re-enabled the loudspeaker mid-call; mute it again.
		echo "call-route: re-muting the loudspeaker"
		amixer -q -c "$CARD" cset name="$CTL" 0
	fi

	if [ "$now" = call ]; then
		sleep 0.5
	else
		sleep 1
	fi
done
