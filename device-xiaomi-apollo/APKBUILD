# Reference: <https://postmarketos.org/devicepkg>
maintainer="royka1 <roykaandorp@gmail.com>"
pkgname=device-xiaomi-apollo
pkgdesc="Xiaomi Mi 10T / 10T Pro"
pkgver=9
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-postmarketos-qcom-sm8250
	mkbootimg
	postmarketos-base
	bootmac
	hexagonrpcd
	hexagonrpcd-apollo
	soc-qcom
	soc-qcom-qbootctl
	firmware-xiaomi-apollo
	firmware-xiaomi-apollo-sensors
	firmware-xiaomi-apollo-modem
	firmware-xiaomi-apollo-dsp
	firmware-xiaomi-apollo-audio
	alsa-ucm-conf-xiaomi-apollo
	apollo-modem-support
	apollo-modem-tools
	tqftpserv-sdx55
	rmtfs
	pd-mapper
	alsa-utils
	q6voiced
	linux-firmware-ath11k
	linux-firmware-qca
	modemmanager
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	modules-initfs
	apollo-call-route
	apollo-call-route.service
	apollo-voice-topology.service
	apollo-camera-variant
	apollo-camera-variant.service
	apollo-suspend-heal
	ath11k-wow.conf
	50-sensor-daemon-restart.conf
	q6voiced.conf
	90-apollo-call-audio.preset
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm755 "$srcdir"/apollo-call-route \
		"$pkgdir"/usr/bin/apollo-call-route
	install -Dm644 "$srcdir"/apollo-call-route.service \
		"$pkgdir"/usr/lib/systemd/system/apollo-call-route.service
	install -Dm644 "$srcdir"/apollo-voice-topology.service \
		"$pkgdir"/usr/lib/systemd/system/apollo-voice-topology.service

	# Boot-time selection of the fitted main-camera module (Semco or
	# Sunny); the Sunny fit is switched in with a device tree overlay.
	install -Dm755 "$srcdir"/apollo-camera-variant \
		"$pkgdir"/usr/bin/apollo-camera-variant
	install -Dm644 "$srcdir"/apollo-camera-variant.service \
		"$pkgdir"/usr/lib/systemd/system/apollo-camera-variant.service

	# s2idle support: keep the WiFi firmware alive across suspend, close
	# the FastRPC sensor session around it, and self-heal sensor daemons.
	install -Dm644 "$srcdir"/ath11k-wow.conf \
		"$pkgdir"/usr/lib/modprobe.d/ath11k-wow.conf
	install -Dm755 "$srcdir"/apollo-suspend-heal \
		"$pkgdir"/usr/lib/systemd/system-sleep/apollo-suspend-heal
	install -Dm644 "$srcdir"/50-sensor-daemon-restart.conf \
		"$pkgdir"/usr/lib/systemd/system/iio-sensor-proxy.service.d/50-restart.conf
	install -Dm644 "$srcdir"/50-sensor-daemon-restart.conf \
		"$pkgdir"/usr/lib/systemd/system/hexagonrpcd-sdsp.service.d/50-restart.conf

	# q6voiced holds the CS-VOICE front end open for the length of a call.
	# It reads this to find the PCM: card 0, device 3.
	install -Dm644 "$srcdir"/q6voiced.conf \
		"$pkgdir"/usr/share/q6voiced/q6voiced.conf

	install -Dm644 "$srcdir"/90-apollo-call-audio.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/90-apollo-call-audio.preset
}

