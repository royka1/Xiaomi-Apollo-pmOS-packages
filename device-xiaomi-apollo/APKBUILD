# Reference: <https://postmarketos.org/devicepkg>
maintainer="royka1 <roykaandorp@gmail.com>"
pkgname=device-xiaomi-apollo
pkgdesc="Xiaomi Mi 10T / 10T Pro"
pkgver=5
pkgrel=0
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-postmarketos-qcom-sm8250
	mkbootimg
	postmarketos-base
	bootmac
	hexagonrpcd
	hexagonrpcd-apollo
	soc-qcom
	soc-qcom-qbootctl
	firmware-xiaomi-apollo
	firmware-xiaomi-apollo-sensors
	firmware-xiaomi-apollo-modem
	firmware-xiaomi-apollo-dsp
	firmware-xiaomi-apollo-audio
	alsa-ucm-conf-xiaomi-apollo
	apollo-modem-support
	apollo-modem-tools
	tqftpserv-sdx55
	rmtfs
	pd-mapper
	alsa-utils
	q6voiced
	linux-firmware-ath11k
	linux-firmware-qca
	modemmanager
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	modules-initfs
	apollo-call-route
	apollo-call-route.service
	apollo-voice-topology.service
	q6voiced.conf
	90-apollo-call-audio.preset
"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm755 "$srcdir"/apollo-call-route \
		"$pkgdir"/usr/bin/apollo-call-route
	install -Dm644 "$srcdir"/apollo-call-route.service \
		"$pkgdir"/usr/lib/systemd/system/apollo-call-route.service
	install -Dm644 "$srcdir"/apollo-voice-topology.service \
		"$pkgdir"/usr/lib/systemd/system/apollo-voice-topology.service

	# q6voiced holds the CS-VOICE front end open for the length of a call.
	# It reads this to find the PCM: card 0, device 3.
	install -Dm644 "$srcdir"/q6voiced.conf \
		"$pkgdir"/usr/share/q6voiced/q6voiced.conf

	install -Dm644 "$srcdir"/90-apollo-call-audio.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/90-apollo-call-audio.preset
}

