[Unit]
Description=SDX55 remote filesystem (upstream tqftpserv, patched for instance 3)
# Upstream tqftpserv hardcodes qrtr_publish(fd, 4096, 1, 0) -> QRTR instance 1,
# but the PCIe-attached SDX55 looks up instance 3 ("name = [sid = 4096,
# iid = 3]" in its own F3 log) and therefore never resolves it. This unit runs
# a build patched to publish instance 3.
#
# Path mapping is tqftpserv's own (translate.c):
#   /readonly/firmware/image/... -> <firmware_class path>/<remoteproc firmware
#                                   dirname>/...  i.e. /lib/firmware/qcom/sdx55m/
#                                   where modem_pr is symlinked to the modem partition
#   /readwrite/...               -> /var/lib/tqftpserv
After=systemd-udevd.service
Wants=systemd-udevd.service
# The stock package publishes instance 1 and would serve nothing here; keep it
# out of the way so only one server answers.
Conflicts=tqftpserv.service

[Service]
Type=simple
ExecStartPre=/bin/sh -c 'mkdir -p /mnt/modemfw /var/lib/tqftpserv'
ExecStartPre=/bin/sh -c 'mountpoint -q /mnt/modemfw || mount -o ro /dev/disk/by-partlabel/modem /mnt/modemfw'
ExecStartPre=/bin/sh -c '[ -e /lib/firmware/qcom/sdx55m/modem_pr ] || ln -s /mnt/modemfw/image/modem_pr /lib/firmware/qcom/sdx55m/modem_pr'
ExecStart=/usr/bin/tqftpserv-sdx55
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
