# Maintainer: royka1 <roykaandorp@gmail.com>
pkgname=tqftpserv-sdx55
pkgver=1.0
pkgrel=0
pkgdesc="TFTP/RFS server over QRTR, patched for the PCIe-attached SDX55 (apollo)"
url="https://github.com/royka1/Xiaomi-Apollo-pmOS-packages"
arch="aarch64"
license="BSD-3-Clause"
depends="qrtr"
makedepends="qrtr-dev zstd-dev"
install="$pkgname.post-install"
# Conflicts with upstream tqftpserv: both would publish an RFS server on QRTR.
provides="tqftpserv-apollo=$pkgver-r$pkgrel"
options="!check"
source="
	tqftpserv.c
	translate.c
	zstd-decompress.c
	list.h
	translate.h
	zstd-decompress.h
	tqftpserv-sdx55.service
	90-tqftpserv-sdx55.preset
"

# Two changes against upstream tqftpserv, both genuine upstream bugs:
#
#  1. qrtr_publish(fd, 4096, 1, 0) -> (fd, 4096, 3, 0). The PCIe-attached
#     SDX55 looks up instance 3; upstream only publishes instance 1, so every
#     read/write times out with "could not resolve remote host".
#
#  2. tftp_send_data() did `return send(...)` and discarded failures. At the
#     modem's negotiated blksize=7680 x wsize=10 (~75 kB per window) the QRTR
#     socket send buffer runs out and block 8 fails every time; the stalled
#     transfer makes the modem ERRFATAL ~64 s later. send_retry() polls for
#     POLLOUT and retries on EAGAIN/EWOULDBLOCK/ENOBUFS/EINTR.
#
# Both are worth reporting upstream.

build() {
	# zstd-decompress.h only declares zstd_decompress_file() when HAVE_ZSTD is
	# set; without it the header defines a static stub that collides with the
	# real definition. Upstream's meson sets this when it finds libzstd.
	$CC $CFLAGS $LDFLAGS -DHAVE_ZSTD -o tqftpserv-sdx55 \
		"$srcdir"/tqftpserv.c "$srcdir"/translate.c "$srcdir"/zstd-decompress.c \
		-I"$srcdir" -lqrtr -lzstd
}

package() {
	install -Dm755 tqftpserv-sdx55 "$pkgdir"/usr/bin/tqftpserv-sdx55
	install -Dm644 "$srcdir"/tqftpserv-sdx55.service \
		"$pkgdir"/usr/lib/systemd/system/tqftpserv-sdx55.service

	install -Dm644 "$srcdir"/90-tqftpserv-sdx55.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/90-tqftpserv-sdx55.preset
}

