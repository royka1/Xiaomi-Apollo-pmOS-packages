# Maintainer: royka1 <roykaandorp@gmail.com>
pkgname=apollo-modem-tools
pkgver=1.0
pkgrel=17
pkgdesc="Userspace services the SDX55 expects on the AP (Xiaomi Mi 10T / apollo)"
url="https://github.com/royka1/Xiaomi-Apollo-pmOS-packages"
arch="aarch64"
license="GPL-2.0-only"
# linux/qrtr.h
makedepends="linux-headers"
install="$pkgname.post-install"
options="!check"
source="
	pm_service_native.c
	mdm_helper_native.c
	mhi_efs_sync.c
	diag_reader.c
	adsp_diag.c
	pm-service-native.service
	mdm-helper-native.service
	mhi-efs-sync.service
	adsp-diag.service
	90-apollo-modem-tools.preset
"

build() {
	# The SDX55 asks the AP for services Android provides and pmOS does not.
	#
	# pm_service_native answers the Peripheral Manager QMI service, which
	# the modem needs before it will touch secure NV.
	#
	# mdm_helper_native replaces the vendor ESOC mdm_helper: it drives the
	# AP2MDM sideband handshake and signals BOOT_DONE.
	#
	# The modem's remote filesystem is served by tqftpserv-sdx55 (patched
	# upstream tqftpserv), NOT by a hand-rolled server: one missing seek/rsize
	# returns wrong bytes on offset reads and the modem drops the SIM.
	#
	# mhi_efs_sync replaces Android's /vendor/bin/ks on MHI channel 10.
	$CC $CFLAGS $LDFLAGS -o pm_service_native "$srcdir"/pm_service_native.c
	$CC $CFLAGS $LDFLAGS -o mdm_helper_native "$srcdir"/mdm_helper_native.c
	$CC $CFLAGS $LDFLAGS -o mhi_efs_sync "$srcdir"/mhi_efs_sync.c
	# DIAG reader: the only way to see what the modem itself thinks.
	$CC $CFLAGS $LDFLAGS -o diag_reader "$srcdir"/diag_reader.c
	# The same, for the ADSP: it speaks DIAG over three glink channels that
	# nothing else opens, and it is the one agent in the call-audio path
	# whose reasoning has never been observed. Needs CONFIG_RPMSG_CTRL.
	$CC $CFLAGS $LDFLAGS -o adsp_diag "$srcdir"/adsp_diag.c
}

package() {
	install -Dm755 pm_service_native "$pkgdir"/usr/bin/pm_service_native
	install -Dm755 mdm_helper_native "$pkgdir"/usr/bin/mdm_helper_native
	install -Dm755 mhi_efs_sync "$pkgdir"/usr/bin/mhi_efs_sync
	install -Dm755 diag_reader "$pkgdir"/usr/bin/diag_reader
	install -Dm755 adsp_diag "$pkgdir"/usr/bin/adsp_diag

	install -Dm644 "$srcdir"/pm-service-native.service \
		"$pkgdir"/usr/lib/systemd/system/pm-service-native.service
	install -Dm644 "$srcdir"/mdm-helper-native.service \
		"$pkgdir"/usr/lib/systemd/system/mdm-helper-native.service
	install -Dm644 "$srcdir"/mhi-efs-sync.service \
		"$pkgdir"/usr/lib/systemd/system/mhi-efs-sync.service
	install -Dm644 "$srcdir"/adsp-diag.service \
		"$pkgdir"/usr/lib/systemd/system/adsp-diag.service

	install -Dm644 "$srcdir"/90-apollo-modem-tools.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/90-apollo-modem-tools.preset
}

