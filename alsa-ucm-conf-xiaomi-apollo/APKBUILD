# Maintainer: royka1 <roykaandorp@gmail.com>
pkgname=alsa-ucm-conf-xiaomi-apollo
pkgver=1.0
pkgrel=7
pkgdesc="ALSA UCM configuration for the Xiaomi Mi 10T / 10T Pro (apollo)"
url="https://github.com/royka1/Xiaomi-Apollo-pmOS-packages"
arch="noarch"
license="BSD-3-Clause"
depends="alsa-ucm-conf"
options="!check"
source="
	HiFi.conf
	VoiceCall.conf
	Xiaomi-Mi-10T.conf
"

package() {
	local ucm="$pkgdir"/usr/share/alsa/ucm2

	install -Dm644 "$srcdir"/HiFi.conf "$ucm"/Xiaomi-Mi-10T/HiFi.conf
	install -Dm644 "$srcdir"/VoiceCall.conf "$ucm"/Xiaomi-Mi-10T/VoiceCall.conf
	install -Dm644 "$srcdir"/Xiaomi-Mi-10T.conf "$ucm/Xiaomi-Mi-10T/Xiaomi Mi 10T.conf"

	# alsa-lib looks the card up under conf.d/<driver>/. The card reports
	# its short name as "X10T" and its long name as "Xiaomi Mi 10T"; which
	# one is used depends on the alsa-lib version, so provide both.
	mkdir -p "$ucm"/conf.d/sm8250
	ln -s "../../Xiaomi-Mi-10T/Xiaomi Mi 10T.conf" "$ucm"/conf.d/sm8250/X10T.conf
	ln -s "../../Xiaomi-Mi-10T/Xiaomi Mi 10T.conf" "$ucm/conf.d/sm8250/Xiaomi Mi 10T.conf"
}

sha512sums="
