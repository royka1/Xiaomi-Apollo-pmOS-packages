# Maintainer: royka1 <roykaandorp@gmail.com>
pkgname=firmware-xiaomi-apollo-sensors
pkgver=1.0
pkgrel=0
pkgdesc="Sensor registry and DSP configuration for the Xiaomi Mi 10T (apollo)"
url="https://github.com/royka1/Xiaomi-Apollo-pmOS-packages"
arch="aarch64"
license="proprietary"
options="!check !strip !archcheck !spdx !tracedeps textrels pmb:cross-native"
source="apollo-sensors-$pkgver.tar.gz"

# HexagonFS serves this tree to the sensor DSP. Without it SLPI has no registry
# to read, crash-loops roughly 25 times a minute, and takes the rest of the
# system down with it. Taken from the stock firmware; no per-device data.

package() {
	mkdir -p "$pkgdir"/usr/share/qcom
	cp -a "$srcdir"/sm8250 "$pkgdir"/usr/share/qcom/
}

sha512sums="
