diff -urN base/src/ipa/simple/algorithms/af.cpp b/src/ipa/simple/algorithms/af.cpp
--- base/src/ipa/simple/algorithms/af.cpp	1970-01-01 01:00:00.000000000 +0100
+++ b/src/ipa/simple/algorithms/af.cpp	2026-08-17 20:56:29.935417327 +0200
@@ -0,0 +1,315 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026 Roy Kaandorp
+ *
+ * Contrast based autofocus for the software ISP
+ *
+ * A classic contrast-detection loop on top of the sharpness statistic the
+ * CPU stats engine gathers: sweep the lens coarsely across its range, sweep
+ * again finely around the best position, hold there, and rescan when the
+ * scene changes enough that the held position has clearly stopped being the
+ * sharp one. Nothing here knows the lens geometry; positions are the lens
+ * driver's own units, taken from its V4L2 control range.
+ */
+
+#include "af.h"
+
+#include <algorithm>
+#include <array>
+
+#include <libcamera/base/log.h>
+
+#include <libcamera/control_ids.h>
+
+namespace libcamera {
+
+LOG_DEFINE_CATEGORY(IPASoftAf)
+
+namespace ipa::soft::algorithms {
+
+int Af::init(IPAContext &context, const ValueNode &tuningData)
+{
+	if (!context.lensPresent) {
+		LOG(IPASoftAf, Warning)
+			<< "Autofocus requested by the tuning file but the "
+			   "camera has no focus lens";
+		return 0;
+	}
+
+	coarseSteps_ = tuningData["coarseSteps"].get<uint32_t>(9);
+	fineSteps_ = tuningData["fineSteps"].get<uint32_t>(5);
+	settleFrames_ = tuningData["settleFrames"].get<uint32_t>(1);
+	refocusRatio_ = tuningData["refocusRatio"].get<double>(0.5);
+	refocusFrames_ = tuningData["refocusFrames"].get<uint32_t>(4);
+
+	static const std::array<ControlValue, 3> afModeValues = {
+		ControlValue(static_cast<int32_t>(controls::AfModeManual)),
+		ControlValue(static_cast<int32_t>(controls::AfModeAuto)),
+		ControlValue(static_cast<int32_t>(controls::AfModeContinuous)),
+	};
+	context.ctrlMap[&controls::AfMode] = ControlInfo(
+		Span<const ControlValue>(afModeValues),
+		ControlValue(static_cast<int32_t>(controls::AfModeContinuous)));
+	context.ctrlMap[&controls::AfTrigger] = ControlInfo(
+		ControlValue(static_cast<int32_t>(controls::AfTriggerStart)),
+		ControlValue(static_cast<int32_t>(controls::AfTriggerCancel)),
+		ControlValue(static_cast<int32_t>(controls::AfTriggerStart)));
+	/*
+	 * Normalised: 0.0 is the near end of the lens travel, 1.0 the far
+	 * end. The units are not dioptres, as nothing is known about the
+	 * optics; this is honest, if not what the control strictly asks for.
+	 */
+	context.ctrlMap[&controls::LensPosition] = ControlInfo(0.0f, 1.0f, 0.5f);
+
+	return 0;
+}
+
+int Af::configure(IPAContext &context,
+		  [[maybe_unused]] const IPAConfigInfo &configInfo)
+{
+	if (!context.lensPresent)
+		return 0;
+
+	auto &af = context.activeState.af;
+
+	af.mode = controls::AfModeContinuous;
+	af.position = context.lensMinPos +
+		      (context.lensMaxPos - context.lensMinPos) / 2;
+	af.dirty = true;
+
+	state_ = State::Idle;
+	scanRequested_ = false;
+	settle_ = 0;
+	dropCount_ = 0;
+
+	return 0;
+}
+
+void Af::moveTo(IPAContext &context, int32_t position)
+{
+	position = std::clamp(position, context.lensMinPos, context.lensMaxPos);
+
+	auto &af = context.activeState.af;
+	if (af.position != position || state_ == State::Idle) {
+		af.position = position;
+		af.dirty = true;
+	}
+	settle_ = settleFrames_;
+}
+
+void Af::startScan(IPAContext &context, int32_t rangeMin, int32_t rangeMax,
+		   unsigned int steps)
+{
+	rangeMin = std::max(rangeMin, context.lensMinPos);
+	rangeMax = std::min(rangeMax, context.lensMaxPos);
+
+	scanPositions_.clear();
+	for (unsigned int i = 0; i < steps; i++)
+		scanPositions_.push_back(
+			rangeMin + (rangeMax - rangeMin) * static_cast<int32_t>(i) /
+					   static_cast<int32_t>(steps - 1));
+
+	scanIndex_ = 0;
+	bestSharpness_ = 0;
+	bestPos_ = scanPositions_[0];
+	state_ = State::Scanning;
+	moveTo(context, scanPositions_[0]);
+}
+
+void Af::queueRequest(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		      [[maybe_unused]] IPAFrameContext &frameContext,
+		      const ControlList &controls)
+{
+	if (!context.lensPresent)
+		return;
+
+	auto &af = context.activeState.af;
+
+	const auto &afMode = controls.get(controls::AfMode);
+	if (afMode) {
+		af.mode = *afMode;
+		if (af.mode == controls::AfModeContinuous) {
+			scanRequested_ = true;
+		} else {
+			/* Hold the current position until told otherwise */
+			state_ = State::Idle;
+			scanRequested_ = false;
+		}
+	}
+
+	const auto &lensPosition = controls.get(controls::LensPosition);
+	if (lensPosition && af.mode == controls::AfModeManual) {
+		float v = std::clamp(*lensPosition, 0.0f, 1.0f);
+		moveTo(context,
+		       context.lensMinPos +
+			       static_cast<int32_t>(v * (context.lensMaxPos -
+							 context.lensMinPos)));
+	}
+
+	const auto &afTrigger = controls.get(controls::AfTrigger);
+	if (afTrigger && af.mode == controls::AfModeAuto) {
+		if (*afTrigger == controls::AfTriggerStart)
+			scanRequested_ = true;
+		else
+			state_ = State::Idle;
+	}
+}
+
+void Af::process(IPAContext &context, [[maybe_unused]] const uint32_t frame,
+		 [[maybe_unused]] IPAFrameContext &frameContext,
+		 const SwIspStats *stats,
+		 ControlList &metadata)
+{
+	if (!context.lensPresent)
+		return;
+
+	auto &af = context.activeState.af;
+
+	const float range = context.lensMaxPos - context.lensMinPos;
+	metadata.set(controls::LensPosition,
+		     range > 0 ? (af.position - context.lensMinPos) / range : 0.0f);
+	metadata.set(controls::AfState,
+		     state_ == State::Scanning ? controls::AfStateScanning
+		     : state_ == State::Locked ? controls::AfStateFocused
+					       : controls::AfStateIdle);
+
+	if (af.mode == controls::AfModeManual)
+		return;
+
+	/* Sharpness is only gathered on frames with valid statistics. */
+	if (!stats->valid)
+		return;
+
+	if (scanRequested_) {
+		scanRequested_ = false;
+		fineDone_ = false;
+		fullScan_ = true;
+		startScan(context, context.lensMinPos, context.lensMaxPos,
+			  coarseSteps_);
+		return;
+	}
+
+	if (af.mode == controls::AfModeContinuous && state_ == State::Idle) {
+		fineDone_ = false;
+		fullScan_ = true;
+		startScan(context, context.lensMinPos, context.lensMaxPos,
+			  coarseSteps_);
+		return;
+	}
+
+	if (settle_ > 0) {
+		settle_--;
+		return;
+	}
+
+	/*
+	 * Squared gradients scale with the square of the scene brightness, so
+	 * a change of exposure would masquerade as a change of focus.
+	 * Normalise by the mean luminance, computed from the histogram the
+	 * stats engine already fills.
+	 */
+	uint64_t ySum = 0, yCount = 0;
+	for (unsigned int i = 0; i < SwIspStats::kYHistogramSize; i++) {
+		ySum += static_cast<uint64_t>(stats->yHistogram[i]) * (2 * i + 1);
+		yCount += stats->yHistogram[i];
+	}
+	const uint64_t meanY = yCount ? ySum / (2 * yCount) : 0;
+	const uint64_t sharpness =
+		stats->sharpness * 256 / std::max<uint64_t>(meanY * meanY, 1);
+
+	switch (state_) {
+	case State::Scanning:
+		if (sharpness > bestSharpness_) {
+			bestSharpness_ = sharpness;
+			bestPos_ = scanPositions_[scanIndex_];
+		}
+
+		scanIndex_++;
+		if (scanIndex_ < scanPositions_.size()) {
+			moveTo(context, scanPositions_[scanIndex_]);
+			break;
+		}
+
+		/*
+		 * A windowed rescan that peaks at its own edge went the wrong
+		 * way: the subject moved further than the window. Escalate to
+		 * the full range.
+		 */
+		if (!fullScan_ &&
+		    (bestPos_ <= scanPositions_.front() ||
+		     bestPos_ >= scanPositions_.back())) {
+			fineDone_ = false;
+			fullScan_ = true;
+			startScan(context, context.lensMinPos,
+				  context.lensMaxPos, coarseSteps_);
+			break;
+		}
+
+		if (!fineDone_) {
+			/* Fine pass, one coarse step wide around the best */
+			int32_t coarseStep =
+				(context.lensMaxPos - context.lensMinPos) /
+				static_cast<int32_t>(coarseSteps_ - 1);
+			fineDone_ = true;
+			startScan(context, bestPos_ - coarseStep,
+				  bestPos_ + coarseStep, fineSteps_);
+			break;
+		}
+
+		moveTo(context, bestPos_);
+		lockedSharpness_ = bestSharpness_;
+		dropCount_ = 0;
+		state_ = State::Locked;
+		LOG(IPASoftAf, Debug)
+			<< "Focused at " << bestPos_
+			<< " sharpness " << bestSharpness_;
+		break;
+
+	case State::Locked:
+		if (af.mode != controls::AfModeContinuous)
+			break;
+
+		/*
+		 * The measure of a changed scene: the held position has
+		 * stopped being anywhere near as sharp as when it won the
+		 * scan, and stays that way.
+		 */
+		if (sharpness <
+		    static_cast<uint64_t>(lockedSharpness_ * refocusRatio_)) {
+			dropCount_++;
+			if (dropCount_ >= refocusFrames_) {
+				/*
+				 * The subject usually has not gone far: look
+				 * around the current position first, a third
+				 * of the range wide. The full sweep happens
+				 * only if the peak sits at the window edge.
+				 */
+				int32_t window =
+					(context.lensMaxPos - context.lensMinPos) / 3;
+				fineDone_ = false;
+				fullScan_ = false;
+				startScan(context, af.position - window / 2,
+					  af.position + window / 2,
+					  fineSteps_);
+			}
+		} else {
+			dropCount_ = 0;
+			/*
+			 * Sharpness of the same scene drifts with exposure;
+			 * follow it slowly so the reference stays honest.
+			 */
+			lockedSharpness_ =
+				(lockedSharpness_ * 15 + sharpness) / 16;
+		}
+		break;
+
+	case State::Idle:
+		break;
+	}
+}
+
+REGISTER_IPA_ALGORITHM(Af, "Af")
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
