--- base/src/ipa/simple/algorithms/af.h	1970-01-01 01:00:00.000000000 +0100
+++ b/src/ipa/simple/algorithms/af.h	2026-08-17 20:56:29.936382534 +0200
@@ -0,0 +1,71 @@
+/* SPDX-License-Identifier: LGPL-2.1-or-later */
+/*
+ * Copyright (C) 2026 Roy Kaandorp
+ *
+ * Contrast based autofocus for the software ISP
+ */
+
+#pragma once
+
+#include <stdint.h>
+#include <algorithm>
+#include <vector>
+
+#include "algorithm.h"
+
+namespace libcamera {
+
+namespace ipa::soft::algorithms {
+
+class Af : public Algorithm
+{
+public:
+	Af() = default;
+	~Af() = default;
+
+	int init(IPAContext &context, const ValueNode &tuningData) override;
+	int configure(IPAContext &context, const IPAConfigInfo &configInfo) override;
+	void queueRequest(IPAContext &context, const uint32_t frame,
+			  IPAFrameContext &frameContext,
+			  const ControlList &controls) override;
+	void process(IPAContext &context, const uint32_t frame,
+		     IPAFrameContext &frameContext,
+		     const SwIspStats *stats,
+		     ControlList &metadata) override;
+
+private:
+	enum class State {
+		Idle,
+		Scanning,
+		Locked,
+	};
+
+	void startScan(IPAContext &context, int32_t rangeMin, int32_t rangeMax,
+		       unsigned int steps);
+	void moveTo(IPAContext &context, int32_t position);
+
+	State state_ = State::Idle;
+	bool scanRequested_ = false;
+
+	std::vector<int32_t> scanPositions_;
+	unsigned int scanIndex_ = 0;
+	bool fineDone_ = false;
+	bool fullScan_ = false;
+	unsigned int settle_ = 0;
+
+	int32_t bestPos_ = 0;
+	uint64_t bestSharpness_ = 0;
+	uint64_t lockedSharpness_ = 0;
+	unsigned int dropCount_ = 0;
+
+	/* Tuning parameters */
+	unsigned int coarseSteps_;
+	unsigned int fineSteps_;
+	unsigned int settleFrames_;
+	double refocusRatio_;
+	unsigned int refocusFrames_;
+};
+
+} /* namespace ipa::soft::algorithms */
+
+} /* namespace libcamera */
