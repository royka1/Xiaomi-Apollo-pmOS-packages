+static char *normalize_under_root(const char *root_prefix, const char *path)
+{
+	char *copy, *segment, *next, *result;
+	char **segments = NULL;
+	size_t i, n_segments = 0, result_len;
+
+	copy = strdup(path);
+	if (copy == NULL)
+		return NULL;
+
+	next = copy;
+	while (*next != '\0') {
+		while (*next == '/')
+			next++;
+		if (*next == '\0')
+			break;
+
+		segment = next;
+		next = strchr(next, '/');
+		if (next != NULL)
+			*next++ = '\0';
+		else
+			next = segment + strlen(segment);
+
+		if (!strcmp(segment, "."))
+			continue;
+
+		if (!strcmp(segment, "..")) {
+			if (n_segments > 0)
+				n_segments--;
+			continue;
+		}
+
+		segments = realloc(segments, sizeof(*segments) * (n_segments + 1));
+		if (segments == NULL) {
+			free(copy);
+			return NULL;
+		}
+
+		segments[n_segments++] = segment;
+	}
+
+	result_len = strlen(root_prefix) + 1;
+	for (i = 0; i < n_segments; i++)
+		result_len += strlen(segments[i]) + 1;
+
+	result = malloc(result_len);
+	if (result == NULL) {
+		free(segments);
+		free(copy);
+		return NULL;
+	}
+
+	strcpy(result, root_prefix);
+	for (i = 0; i < n_segments; i++) {
+		strcat(result, "/");
+		strcat(result, segments[i]);
+	}
+
+	free(segments);
+	free(copy);
+	return result;
+}
+
+static char *resolve_persist_write_path(struct apps_std_ctx *ctx, const char *path)
+{
+	static const char persist_prefix[] = "/mnt/vendor/persist";
+	static const char registry_virtual_prefix[] = "/sensors/registry/registry/";
+	static const char registry_host_prefix[] = "/sensors/registry/";
+	char *normalized_virtual = NULL;
+	char *mapped = NULL;
+	char *resolved = NULL;
+	size_t mapped_len;
+
+	if (strncmp(path, persist_prefix, sizeof(persist_prefix) - 1) != 0)
+		return NULL;
+
+	normalized_virtual = normalize_under_root("",
+						  path + sizeof(persist_prefix) - 1);
+	if (normalized_virtual == NULL)
+		return NULL;
+
+	if (!strcmp(normalized_virtual, "/sensors/registry/sns_reg_version")) {
+		mapped = strdup("/sensors/sns_reg_version");
+	} else if (!strcmp(normalized_virtual, "/sensors/registry/temp.json")) {
+		mapped = strdup("/sensors/temp.json");
+	} else if (!strcmp(normalized_virtual,
+			   "/sensors/registry/sns_reg_config")) {
+		mapped = strdup("/sensors/registry/sns_reg_config");
+	} else if (!strncmp(normalized_virtual, registry_virtual_prefix,
+			    sizeof(registry_virtual_prefix) - 1)) {
+		mapped_len = strlen(registry_host_prefix) +
+			     strlen(normalized_virtual + sizeof(registry_virtual_prefix) - 1) + 1;
+		mapped = malloc(mapped_len);
+		if (mapped != NULL) {
+			strcpy(mapped, registry_host_prefix);
+			strcat(mapped,
+			       normalized_virtual + sizeof(registry_virtual_prefix) - 1);
+		}
+	}
+
+	if (mapped != NULL)
+		resolved = normalize_under_root(ctx->root_prefix, mapped);
+
+	free(mapped);
+	free(normalized_virtual);
+	return resolved;
+}
+
+static bool path_has_suffix(const char *path, const char *suffix)
+{
+	size_t path_len = strlen(path);
+	size_t suffix_len = strlen(suffix);
+
+	if (path_len < suffix_len)
+		return false;
+
+	return !strcmp(path + path_len - suffix_len, suffix);
+}
+
+static int copy_file_contents(const char *src_path, const char *dst_path)
+{
+	char buf[4096];
+	ssize_t n_read;
+	int src_fd, dst_fd;
+
+	src_fd = open(src_path, O_RDONLY);
+	if (src_fd < 0)
+		return -errno;
+
+	dst_fd = open(dst_path, O_WRONLY | O_CREAT | O_TRUNC, 0666);
+	if (dst_fd < 0) {
+		n_read = -errno;
+		close(src_fd);
+		return n_read;
+	}
+
+	while ((n_read = read(src_fd, buf, sizeof(buf))) > 0) {
+		ssize_t written = 0;
+
+		while (written < n_read) {
+			ssize_t n_written = write(dst_fd, buf + written, n_read - written);
+			if (n_written < 0) {
+				n_read = -errno;
+				close(dst_fd);
+				close(src_fd);
+				return n_read;
+			}
+			written += n_written;
+		}
+	}
+
+	if (n_read < 0)
+		n_read = -errno;
+
+	close(dst_fd);
+	close(src_fd);
+	return n_read < 0 ? (int) n_read : 0;
+}
