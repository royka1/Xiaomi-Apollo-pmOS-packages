# Maintainer: royka1 <roykaandorp@gmail.com>
pkgname=hexagonrpcd-apollo
pkgver=0.4.0
pkgrel=0
_commit="93f3467dcfe1601bb70547611866a069ae914de5"
pkgdesc="HexagonFS daemon with the fixes the Xiaomi Mi 10T (apollo) sensors need"
url="https://github.com/linux-msm/hexagonrpc"
arch="aarch64"
license="GPL-2.0-or-later"
# Reuses libhexagonrpc and chrecd from the stock package; only the daemon
# differs, so that has to stay installed.
depends="hexagonrpcd"
makedepends="meson hexagonrpcd"
options="!check"
subpackages="$pkgname-systemd:systemd"
source="
	hexagonrpc-$_commit.tar.gz::https://github.com/linux-msm/hexagonrpc/archive/$_commit.tar.gz
	apollo-sensor-fixes.patch
	hexagonrpcd-adsp-rootpd.service.d-apollo.conf
	hexagonrpcd-adsp-sensorspd.service.d-apollo.conf
	hexagonrpcd-sdsp.service.d-apollo.conf
"
builddir="$srcdir/hexagonrpc-$_commit"

build() {
	abuild-meson . output
	meson compile -C output
}

package() {
	# Only the daemon: the library and chrecd come from the stock package
	# and are unmodified.
	install -Dm755 output/hexagonrpcd/hexagonrpcd \
		"$pkgdir"/usr/bin/hexagonrpcd-apollo

}

systemd() {
	pkgdesc="$pkgdesc (systemd drop-ins)"
	install_if="systemd $pkgname=$pkgver-r$pkgrel"

	# Point the stock units at our daemon rather than replacing them, so
	# upstream stays in charge of ordering and dependencies.
	local s
	for s in hexagonrpcd-adsp-rootpd hexagonrpcd-adsp-sensorspd hexagonrpcd-sdsp; do
		install -Dm644 "$srcdir/$s.service.d-apollo.conf" \
			"$subpkgdir"/usr/lib/systemd/system/$s.service.d/10-apollo.conf
	done
}

