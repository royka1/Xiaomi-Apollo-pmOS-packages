#!/bin/sh
for u in apollo-efs-extract.service apollo-uim-provision.service; do
	ln -sf /usr/lib/systemd/system/$u \
		/etc/systemd/system/multi-user.target.wants/$u 2>/dev/null || true
done

cat <<'MSG'
*
* apollo-modem-support installed.
*
* The modem needs this device's OWN NV images (efs1/2/3.bin). They are not
* shipped -- they contain your IMEI -- so apollo-efs-extract pulls them from
* your mdm1m9kefs1/2/3 partitions on first boot. The modem reads NV very
* early, so cellular starts working on the SECOND boot after a fresh install.
*
* Put the SIM in physical slot 1. In slot 2 nothing addresses the card by
* default and the modem never finishes SIM init.
*
MSG
