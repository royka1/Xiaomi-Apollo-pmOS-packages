# Maintainer: royka1 <roykaandorp@gmail.com>
pkgname=apollo-modem-support
pkgver=1.0
pkgrel=14
pkgdesc="Glue needed to make the external SDX55 modem work on the Xiaomi Mi 10T (apollo)"
url="https://github.com/royka1/Xiaomi-Apollo-pmOS-packages"
arch="noarch"
license="GPL-2.0-only"
depends="libqmi qmi-utils udev"
install="$pkgname.post-install"
options="!check"
source="
	apollo-efs-extract
	apollo-efs-extract.service
	apollo-mm-restart-once
	ModemManager-restart-once.service
	10-apollo-modem-ordering.conf
	zz-apollo-multiplex.conf
	rmnet.conf
	10-apollo-ntp-by-ip.conf
	90-apollo-timesyncd
	apollo-uim-provision
	apollo-uim-provision.service
	apollo-pin-packages
	apollo-pin-packages.service
	90-apollo-modem-support.preset
	77-mm-ignore-sdx55-efs.rules
	77-mm-sdx55-fusion.rules
	81-libssc-xiaomi-apollo.rules
"

package() {
	# Pull this device's own modem NV out of its partitions. Never shipped:
	# efs1/2/3.bin contain the IMEI and RF calibration.
	install -Dm755 "$srcdir"/apollo-efs-extract "$pkgdir"/usr/bin/apollo-efs-extract
	install -Dm644 "$srcdir"/apollo-efs-extract.service \
		"$pkgdir"/usr/lib/systemd/system/apollo-efs-extract.service

	# Nudge ModemManager once if the modem was not there when it started.
	install -Dm755 "$srcdir"/apollo-mm-restart-once \
		"$pkgdir"/usr/bin/apollo-mm-restart-once
	install -Dm644 "$srcdir"/ModemManager-restart-once.service \
		"$pkgdir"/usr/lib/systemd/system/ModemManager-restart-once.service

	# ...and make sure it is not started before the modem can answer at all.
	install -Dm644 "$srcdir"/10-apollo-modem-ordering.conf \
		"$pkgdir"/usr/lib/systemd/system/ModemManager.service.d/10-apollo-modem-ordering.conf
	install -Dm644 "$srcdir"/zz-apollo-multiplex.conf \
		"$pkgdir"/usr/lib/systemd/system/ModemManager.service.d/zz-apollo-multiplex.conf

	# The multiplexed bearer needs the rmnet driver, which nothing else pulls in.
	install -Dm644 "$srcdir"/rmnet.conf \
		"$pkgdir"/usr/lib/modules-load.d/rmnet.conf

	install -Dm644 "$srcdir"/10-apollo-ntp-by-ip.conf \
		"$pkgdir"/usr/lib/systemd/timesyncd.conf.d/10-apollo-ntp-by-ip.conf
	install -Dm755 "$srcdir"/90-apollo-timesyncd \
		"$pkgdir"/usr/lib/NetworkManager/dispatcher.d/90-apollo-timesyncd

	# Enable via a systemd preset. Hand-rolled symlinks into
	# multi-user.target.wants/ fail silently at install time because the
	# directory does not exist yet.
	install -Dm644 "$srcdir"/90-apollo-modem-support.preset \
		"$pkgdir"/usr/lib/systemd/system-preset/90-apollo-modem-support.preset

	# Select the USIM application. msm-modem-uim-selection cannot do this:
	# it probes /dev/modem, /dev/wwan0qmi0 (CID allocation times out there)
	# and then only qrtr://0, while this modem is on QRTR node 3. Only
	# needed when the SIM sits in physical slot 2 -- in slot 1 the modem
	# provisions itself -- but harmless either way.
	# Keep apk upgrade from swapping out the custom kernel or the
	# patched ModemManager.
	install -Dm755 "$srcdir"/apollo-pin-packages "$pkgdir"/usr/bin/apollo-pin-packages
	install -Dm644 "$srcdir"/apollo-pin-packages.service \
		"$pkgdir"/usr/lib/systemd/system/apollo-pin-packages.service

	install -Dm755 "$srcdir"/apollo-uim-provision "$pkgdir"/usr/bin/apollo-uim-provision
	install -Dm644 "$srcdir"/apollo-uim-provision.service \
		"$pkgdir"/usr/lib/systemd/system/apollo-uim-provision.service

	# ModemManager: collapse the QRTR control plane and the mhi_net data
	# plane into one device, and keep MM off the EFS channel (it probes it
	# with AT strings, which the modem's rmts_srv treats as garbage and
	# ERRFATALs on).
	install -Dm644 "$srcdir"/77-mm-ignore-sdx55-efs.rules \
		"$pkgdir"/usr/lib/udev/rules.d/77-mm-ignore-sdx55-efs.rules
	install -Dm644 "$srcdir"/77-mm-sdx55-fusion.rules \
		"$pkgdir"/usr/lib/udev/rules.d/77-mm-sdx55-fusion.rules

	# Accelerometer mount matrix. (10-fastrpc.rules is NOT shipped here --
	# hexagonrpcd-udev already owns it.)
	install -Dm644 "$srcdir"/81-libssc-xiaomi-apollo.rules \
		"$pkgdir"/usr/lib/udev/rules.d/81-libssc-xiaomi-apollo.rules
}

